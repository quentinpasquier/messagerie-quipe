# Postgres en local : utilise Docker (`docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres`)
# ou un service hébergé (Neon, Supabase, Railway Postgres en mode externe).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/messagerie?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string-32-chars-min"
PORT=3000
# Chemin du dossier où stocker les images uploadées. Sur Railway, monte
# un volume persistant à ce chemin (ex: /data) sinon les images sont
# perdues à chaque redémarrage.
UPLOAD_DIR=./uploads
